  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    }
  },
  "layout": {
    "density": "comfortable",
    "shellMaxWidth": "100%",
    "shellPadding": "0",
    "sectionGap": "14px",
    "cardPadding": "18px",
    "gridGap": "14px",
    "sidebarWidth": "72px",
    "shellPreset": "neon-glass-rail",
    "navPosition": "side-icon",
    "cardDensity": "comfortable",
    "buttonHierarchy": "stacked",
    "overlayMode": "drawer",
    "grid": "mosaic"
  },
  "hud": {
    "glowStrength": "0.55",
    "glowSpread": "22px",
    "scanlineOpacity": "0.04",
    "gridOpacity": "0.05",
    "accentPulse": true
  },
  "iconography": {
    "style": "line",
    "strokeWidth": "1.75",
    "sizeSm": "14px",
    "sizeMd": "18px",
    "sizeLg": "24px"
  },
  "components": {
    "shell": {
      "pattern": "glass",
      "blur": "18px",
      "border": "1px solid rgba(255,255,255,.12)"
    },
    "card": {
      "radius": "24px",
      "padding": "18px",
      "backdropBlur": "16px"
    },
    "button": {
      "radius": "999px",
      "padding": "10px 18px",
      "fontWeight": "700",
      "primaryStyle": "solid"
    },
    "input": {
      "radius": "12px",
      "padding": "9px 11px",
      "background": "rgba(7,11,18,.55)"
    },
    "chip": {
      "radius": "999px",
      "padding": "3px 8px",
      "fontSize": "0.72rem"
    },
    "nav": {
      "height": "auto",
      "blur": "18px",
      "gap": "12px",
      "position": "side-icon"
    },
    "table": {
      "rowHeight": "40px",
      "headerWeight": "700",
      "cellPadding": "8px 10px"
    },
    "sheet": {
      "radius": "0 18px 18px 0",
      "maxWidth": "420px",
      "backdrop": "rgba(2,8,16,.65)",
      "mode": "drawer"
    }
  },
  "chrome": {
    "shellPreset": "neon-glass-rail",
    "nav": "side-icon",
    "cardDensity": "comfortable",
    "buttonHierarchy": "stacked",
    "overlay": "drawer",
    "bottomBar": false,
    "grid": "mosaic",
    "classMap": {
      ".top": "aq-chrome-nav",
      ".top-actions": "aq-chrome-actions"
    },
    "cssModules": [
      "theme-studio/layouts/neon-glass-rail.css"
    ],
    "applyScript": "theme-studio/aq-theme-apply.js"
  }
