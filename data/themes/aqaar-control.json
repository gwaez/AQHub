    "--aq-comp-table-row-height": "40px",
    "--aq-comp-table-header-weight": "700",
    "--aq-comp-table-cell-padding": "8px 10px",
    "--aq-comp-sheet-radius": "18px",
    "--aq-comp-sheet-max-width": "500px",
    "--aq-comp-sheet-backdrop": "rgba(2,8,16,.55)",
