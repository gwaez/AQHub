    "--sched": "rgba(56, 189, 248, 0.14)",
    "--deleg": "rgba(167, 139, 250, 0.14)",
    "--elim": "rgba(251, 113, 133, 0.14)",
    "--aq-space-unit": "4px",
    "--aq-space-0": "0",
    "--aq-space-1": "4px",
    "--aq-space-2": "8px",
    "--aq-space-3": "12px",
    "--aq-space-4": "16px",
    "--aq-space-5": "24px",
    "--aq-space-6": "32px",
    "--aq-space-7": "48px",
    "--aq-space-8": "64px",
    "--aq-density": "comfortable",
    "--aq-density-mult": "1",
