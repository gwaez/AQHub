{
  "meta": {
    "id": "aqaar-control",
    "name": "Aqaar Control",
    "version": "1.1.0",
    "author": "AQHub",
    "description": "Default Control Center look — deep slate panels, teal/sky accents, soft purple wash. Close to the classic index/panel palette.",
    "styleKeywords": [
      "control-center",
      "dark",
      "teal",
      "slate",
      "glass"
    ],
    "mode": "dark",
    "studio": "theme-studio"
  },
  "color": {
    "bg": "#070b12",
    "bgSecondary": "#0c1220",
    "surface": "rgba(18, 28, 48, 0.72)",
    "surfaceElevated": "#121c30",
    "border": "rgba(148, 163, 184, 0.14)",
    "borderStrong": "rgba(125, 211, 252, 0.28)",
    "text": "#e8eef8",
    "textMuted": "#8b9bb3",
    "textFaint": "#5d6d86",
    "accent": "#5eead4",
    "accent2": "#38bdf8",
    "accent3": "#a78bfa",
    "success": "#34d399",
    "warning": "#fbbf24",
    "danger": "#fb7185",
    "glow": "rgba(94, 234, 212, 0.35)"
  },
  "typography": {
    "fontFamily": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
    "monoFamily": "\"JetBrains Mono\", ui-monospace, monospace",
    "scale": {
      "xs": "0.72rem",
      "sm": "0.85rem",
      "md": "0.95rem",
      "lg": "1.15rem",
      "xl": "1.45rem"
    },
    "lineHeight": "1.5",
    "letterSpacing": "0"
  },
  "shape": {
    "radiusSm": "12px",
    "radiusMd": "16px",
    "radiusLg": "22px",
    "borderWidth": "1px",
    "radiusPill": "999px"
  },
  "elevation": {
    "shadowSm": "0 10px 30px rgba(0, 0, 0, 0.25)",
    "shadowMd": "0 24px 80px rgba(0, 0, 0, 0.45)",
    "glowBlur": "18px",
    "shadowLg": "0 24px 80px rgba(0, 0, 0, 0.45)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "slow": "300ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "hoverLift": "translateY(-1px)"
  },
  "cssVariables": {
    "--aq-bg": "#070b12",
