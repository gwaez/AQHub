    "--warn": "#fbbf24",
    "--danger": "#fb7185",
    "--hot": "#fb7185",
    "--glow": "rgba(94, 234, 212, 0.35)",
    "--shadow": "0 24px 80px rgba(0, 0, 0, 0.45)",
