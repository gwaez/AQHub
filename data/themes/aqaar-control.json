    "--bg1": "#0c1220",
    "--bg2": "#121a2b",
    "--panel": "rgba(18, 28, 48, 0.85)",
    "--card": "rgba(18, 28, 48, 0.72)",
    "--card-solid": "#121c30",
    "--stroke": "rgba(148, 163, 184, 0.14)",
    "--stroke-strong": "rgba(125, 211, 252, 0.28)",
    "--line": "rgba(148, 163, 184, 0.18)",
    "--text": "#e8eef8",
    "--ink": "#e8eef8",
    "--muted": "#8b9bb3",
    "--faint": "#5d6d86",
    "--accent": "#5eead4",
    "--accent-2": "#38bdf8",
    "--accent-3": "#a78bfa",
    "--cyan": "#5eead4",
    "--teal": "#0f766e",
    "--ok": "#34d399",
    "--warn": "#fbbf24",
