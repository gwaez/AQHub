      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    }
  },
  "layout": {
    "density": "comfortable",
    "shellMaxWidth": "1280px",
    "shellPadding": "16px 18px",
    "sectionGap": "16px",
    "cardPadding": "16px",
    "gridGap": "10px",
