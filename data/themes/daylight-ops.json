  "components": {
    "shell": {
      "pattern": "solid",
      "blur": "0",
      "border": "1px solid var(--aq-border)"
    },
    "card": {
      "radius": "var(--aq-radius-md)",
      "padding": "var(--aq-space-4)",
      "backdropBlur": "0"
    },
    "button": {
      "radius": "12px",
      "padding": "8px 12px",
      "fontWeight": "600",
      "primaryStyle": "solid"
    },
    "input": {
      "radius": "10px",
      "padding": "7px 9px",
      "background": "#ffffff"
    },
    "chip": {
      "radius": "999px",
      "padding": "3px 8px",
      "fontSize": "0.72rem"
    },
    "nav": {
      "height": "52px",
      "blur": "12px",
      "gap": "8px"
    },
    "table": {
      "rowHeight": "40px",
      "headerWeight": "700",
      "cellPadding": "8px 10px"
    },
    "sheet": {
      "radius": "16px",
      "maxWidth": "560px",
      "backdrop": "rgba(15,23,42,.45)"
