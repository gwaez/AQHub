{
  "meta": {
    "id": "daylight-ops",
    "name": "Daylight Ops",
    "version": "1.0.0",
    "author": "AQHub",
    "description": "Light operational theme — paper surfaces, teal accents, readable daylight matrix. Use when a bright board is preferred.",
    "styleKeywords": ["light", "daylight", "ops", "teal", "paper"],
    "mode": "light"
