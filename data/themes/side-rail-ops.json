  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    }
  },
  "layout": {
    "density": "compact",
    "shellMaxWidth": "100%",
    "shellPadding": "0",
    "sectionGap": "12px",
    "cardPadding": "10px",
    "gridGap": "8px",
    "sidebarWidth": "220px",
    "shellPreset": "side-rail-ops",
    "navPosition": "side",
    "cardDensity": "compact",
    "buttonHierarchy": "primary-start",
    "overlayMode": "drawer"
  },
  "hud": {
    "glowStrength": "0.45",
    "glowSpread": "18px",
    "scanlineOpacity": "0.05",
    "gridOpacity": "0.04",
    "accentPulse": true
  },
  "iconography": {
    "style": "line",
    "strokeWidth": "1.75",
    "sizeSm": "14px",
    "sizeMd": "18px",
    "sizeLg": "24px"
  },
  "components": {
    "shell": {
      "pattern": "rail",
      "blur": "18px",
      "border": "1px solid var(--aq-border)"
    },
    "card": {
      "radius": "var(--aq-radius-md)",
      "padding": "10px 12px",
      "backdropBlur": "14px"
    },
    "button": {
      "radius": "var(--aq-radius-md)",
      "padding": "8px 12px",
      "fontWeight": "600",
      "primaryStyle": "solid"
    },
    "input": {
      "radius": "12px",
      "padding": "9px 11px",
      "background": "rgba(7,11,18,.55)"
    },
    "chip": {
      "radius": "999px",
      "padding": "3px 8px",
      "fontSize": "0.72rem"
    },
    "nav": {
      "height": "auto",
      "blur": "12px",
      "gap": "8px"
    },
    "table": {
      "rowHeight": "40px",
      "headerWeight": "700",
      "cellPadding": "8px 10px"
    },
    "sheet": {
      "radius": "18px",
      "maxWidth": "420px",
      "backdrop": "rgba(2,8,16,.55)",
      "mode": "drawer"
    }
  },
  "chrome": {
    "shellPreset": "side-rail-ops",
    "nav": "side",
    "cardDensity": "compact",
    "buttonHierarchy": "primary-start",
    "overlay": "drawer",
    "classMap": {
      ".top": "aq-chrome-nav",
      ".top-actions": "aq-chrome-actions",
      ".actions": "aq-chrome-actions"
    },
    "cssModules": [
      "theme-studio/layouts/side-rail-ops.css"
