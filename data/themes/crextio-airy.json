    "--teal": "#e6b94d",
    "--ok": "#34d399",
    "--warn": "#fbbf24",
    "--danger": "#fb7185",
    "--hot": "#fb7185",
    "--glow": "rgba(230, 185, 77, 0.35)",
    "--shadow": "0 24px 80px rgba(0, 0, 0, 0.45)",
    "--radius": "28px",
    "--hdr": "#8aa4bc",
    "--hdr2": "#5d6d86",
    "--do": "rgba(52, 211, 153, 0.18)",
    "--sched": "rgba(96, 165, 250, 0.16)",
    "--deleg": "rgba(167, 139, 250, 0.16)",
    "--elim": "rgba(251, 113, 133, 0.16)",
    "--aq-space-unit": "4px",
    "--aq-space-0": "0",
    "--aq-space-1": "4px",
    "--aq-space-2": "8px",
    "--aq-space-3": "12px",
    "--aq-space-4": "16px",
    "--aq-space-5": "24px",
    "--aq-space-6": "32px",
    "--aq-space-7": "48px",
    "--aq-space-8": "64px",
    "--aq-density": "spacious",
    "--aq-density-mult": "1.2",
    "--aq-shell-max": "1280px",
    "--aq-shell-pad": "28px 22px",
    "--aq-section-gap": "16px",
    "--aq-card-pad": "16px",
