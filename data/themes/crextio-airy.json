{
  "meta": {
    "id": "crextio-airy",
    "name": "Crextio Airy",
    "version": "1.3.0",
    "author": "AQHub",
    "description": "UI Kit skin from light HR dashboard refs — floating top pill nav, modular white cards, mustard accent. Structural chrome remount on index/panel.",
    "styleKeywords": [
      "crextio",
      "light",
      "pill-nav",
      "airy",
      "mustard",
      "modular-cards",
      "ui-kit"
    ],
    "mode": "light",
    "studio": "theme-studio"
  },
  "color": {
    "bg": "#f3f5f8",
    "bgSecondary": "#eef1f6",
    "surface": "rgba(255,255,255,0.88)",
    "surfaceElevated": "#ffffff",
    "border": "#e5ebf3",
    "borderStrong": "#c9d4e3",
    "text": "#1f2937",
    "textMuted": "#6b7280",
    "textFaint": "#9ca3af",
    "accent": "#e6b94d",
    "accent2": "#f0c96a",
    "accent3": "#2d2d2d",
    "success": "#059669",
    "warning": "#d97706",
    "danger": "#e11d48",
    "glow": "rgba(230, 185, 77, 0.35)"
  },
  "typography": {
    "fontFamily": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
    "monoFamily": "\"JetBrains Mono\", ui-monospace, monospace",
    "scale": {
      "xs": "0.72rem",
      "sm": "0.82rem",
      "md": "0.95rem",
      "lg": "1.15rem",
      "xl": "1.45rem"
    },
    "lineHeight": "1.5",
    "letterSpacing": "0"
  },
  "shape": {
    "radiusSm": "14px",
    "radiusMd": "22px",
    "radiusLg": "28px",
    "borderWidth": "1px",
    "radiusPill": "999px"
  },
  "elevation": {
    "shadowSm": "0 10px 28px rgba(15,23,42,0.06)",
    "shadowMd": "0 18px 50px rgba(15,23,42,0.08)",
    "glowBlur": "16px",
    "shadowLg": "0 24px 60px rgba(15,23,42,0.1)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "slow": "280ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "hoverLift": "translateY(-1px)"
  },
  "cssVariables": {
    "--aq-bg": "#f3f5f8",
    "--aq-bg-secondary": "#eef1f6",
    "--aq-surface": "rgba(255,255,255,0.88)",
