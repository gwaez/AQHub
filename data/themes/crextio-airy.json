    "--aq-font": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
    "--aq-font-mono": "\"JetBrains Mono\", ui-monospace, monospace",
    "--aq-fs-xs": "0.72rem",
    "--aq-fs-sm": "0.82rem",
    "--aq-fs-md": "0.95rem",
    "--aq-fs-lg": "1.15rem",
    "--aq-fs-xl": "1.45rem",
    "--aq-radius-sm": "10px",
    "--aq-radius-md": "14px",
    "--aq-radius-lg": "22px",
    "--aq-border-width": "1px",
