    "--aq-hover-lift": "translateY(-1px)",
    "--aq-comp-shell-pattern": "soft-white",
    "--aq-comp-shell-blur": "18px",
    "--aq-comp-card-radius": "var(--aq-radius-md)",
    "--aq-comp-card-padding": "var(--aq-space-4)",
    "--aq-comp-card-backdrop-blur": "14px",
    "--aq-comp-button-radius": "var(--aq-radius-md)",
    "--aq-comp-button-padding": "10px 14px",
    "--aq-comp-button-font-weight": "600",
    "--aq-comp-button-primary-style": "solid",
    "--aq-comp-input-radius": "12px",
    "--aq-comp-input-padding": "9px 11px",
    "--aq-comp-input-background": "rgba(7,11,18,.55)",
    "--aq-comp-chip-radius": "999px",
    "--aq-comp-chip-padding": "3px 8px",
    "--aq-comp-chip-font-size": "0.72rem",
    "--aq-comp-nav-height": "52px",
    "--aq-comp-nav-blur": "12px",
    "--aq-comp-nav-gap": "8px",
    "--aq-comp-table-row-height": "40px",
    "--aq-comp-table-header-weight": "700",
    "--aq-comp-table-cell-padding": "8px 10px",
    "--aq-comp-sheet-radius": "18px",
    "--aq-comp-sheet-max-width": "500px",
    "--aq-comp-sheet-backdrop": "rgba(2,8,16,.55)",
    "--aq-shell-preset": "crextio-airy",
    "--aq-nav-position": "top-pill",
    "--aq-card-density": "spacious",
    "--aq-btn-hierarchy": "primary-end",
    "--aq-overlay-mode": "sheet"
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    }
  },
  "layout": {
    "density": "spacious",
    "shellMaxWidth": "1280px",
    "shellPadding": "22px",
    "sectionGap": "18px",
    "cardPadding": "22px",
    "gridGap": "16px",
    "sidebarWidth": "0px",
    "shellPreset": "crextio-airy",
    "navPosition": "top-pill",
    "cardDensity": "spacious",
    "buttonHierarchy": "primary-end",
    "overlayMode": "sheet",
    "grid": "modular"
  },
  "hud": {
    "glowStrength": "0.2",
    "glowSpread": "12px",
    "scanlineOpacity": "0",
    "gridOpacity": "0",
    "accentPulse": false
  },
  "iconography": {
    "style": "line",
    "strokeWidth": "1.75",
    "sizeSm": "14px",
    "sizeMd": "18px",
    "sizeLg": "24px"
  },
  "components": {
    "shell": {
      "pattern": "soft-white",
      "blur": "14px",
      "border": "1px solid var(--aq-border)"
    },
    "card": {
      "radius": "28px",
      "padding": "22px",
      "backdropBlur": "0"
    },
    "button": {
      "radius": "999px",
      "padding": "10px 16px",
      "fontWeight": "700",
      "primaryStyle": "solid"
    },
    "input": {
      "radius": "12px",
      "padding": "9px 11px",
      "background": "rgba(7,11,18,.55)"
    },
    "chip": {
      "radius": "999px",
      "padding": "3px 8px",
      "fontSize": "0.72rem"
    },
    "nav": {
      "height": "56px",
      "blur": "14px",
      "gap": "6px",
      "position": "top-pill"
    },
    "table": {
      "rowHeight": "40px",
      "headerWeight": "700",
      "cellPadding": "8px 10px"
    },
    "sheet": {
      "radius": "18px",
      "maxWidth": "500px",
      "backdrop": "rgba(2,8,16,.55)",
      "mode": "sheet"
    }
  },
  "chrome": {
    "shellPreset": "crextio-airy",
    "nav": "top-pill",
    "cardDensity": "spacious",
    "buttonHierarchy": "primary-end",
    "overlay": "sheet",
    "bottomBar": false,
    "grid": "modular",
    "classMap": {
      ".top": "aq-chrome-nav",
      ".top-actions": "aq-chrome-actions"
    },
    "cssModules": [
      "theme-studio/layouts/crextio-airy.css"
    ],
    "applyScript": "theme-studio/aq-theme-apply.js"
  }
}
