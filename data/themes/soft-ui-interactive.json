  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px"
    }
  },
  "layout": {
    "density": "spacious",
    "shellMaxWidth": "none",
    "shellPadding": "0",
    "sectionGap": "16px",
    "cardPadding": "18px",
    "gridGap": "16px",
    "sidebarWidth": "336px",
    "shellPreset": "soft-ui-interactive",
    "navPosition": "soft-dual",
    "cardDensity": "spacious",
    "buttonHierarchy": "primary-end",
    "overlayMode": "sheet",
    "grid": "soft"
  },
  "hud": {
    "glowStrength": "0.18",
    "glowSpread": "12px",
    "scanlineOpacity": "0",
    "gridOpacity": "0",
    "accentPulse": false
  },
  "iconography": {
    "style": "line",
    "strokeWidth": "1.75",
    "sizeSm": "14px",
    "sizeMd": "18px",
    "sizeLg": "24px"
  },
  "components": {
    "shell": {
      "pattern": "soft-white",
      "blur": "12px",
      "border": "1px solid var(--aq-border)"
    },
    "card": {
      "radius": "24px",
      "padding": "18px",
      "backdropBlur": "0"
    },
    "button": {
      "radius": "999px",
      "padding": "10px 16px",
      "fontWeight": "700",
      "primaryStyle": "gradient"
    },
    "input": {
      "radius": "999px",
      "padding": "10px 12px",
      "background": "#ffffff"
    },
    "chip": {
      "radius": "999px",
      "padding": "4px 10px",
      "fontSize": "0.72rem"
    },
    "nav": {
      "height": "auto",
      "blur": "12px",
      "gap": "8px",
      "position": "soft-dual"
    },
    "table": {
      "rowHeight": "40px",
      "headerWeight": "700",
      "cellPadding": "8px 10px"
    },
    "sheet": {
      "radius": "22px",
      "maxWidth": "500px",
      "backdrop": "rgba(15,23,42,.35)",
      "mode": "sheet"
    }
  },
  "chrome": {
    "shellPreset": "soft-ui-interactive",
    "nav": "soft-dual",
    "cardDensity": "spacious",
    "buttonHierarchy": "primary-end",
    "overlay": "sheet",
    "bottomBar": false,
    "analyticsPanel": true,
    "grid": "soft",
    "classMap": {
      ".top": "aq-chrome-nav",
      ".top-actions": "aq-chrome-actions",
      ".actions": "aq-chrome-actions",
      ".aqts-top": "aq-chrome-nav"
    },
    "cssModules": [
      "theme-studio/layouts/soft-ui-interactive.css"
    ],
    "applyScript": "theme-studio/aq-theme-apply.js"
  }
