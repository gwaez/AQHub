{
  "meta": {
    "id": "soft-ui-interactive",
    "name": "Soft UI Interactive",
    "version": "1.4.0",
    "author": "AQHub",
    "description": "UI Kit skin merging Soft UI dashboard chrome (icon rail + project sidebar + floating cards + raised pill tabs) with interactive Kanban motion (drag lift, dashed ghost placeholder). Arabic nav: وارد · مصفوفة · تركيز · ثيم · إعدادات.",
    "styleKeywords": [
      "soft-ui",
      "neomorphic-lite",
      "icon-rail",
      "dual-sidebar",
      "kanban",
      "drag-lift",
      "ghost-placeholder",
      "light",
      "blue",
      "mint",
      "purple",
      "ui-kit"
    ],
    "mode": "light",
    "studio": "theme-studio"
  },
  "color": {
    "bg": "#f3f5f9",
    "bgSecondary": "#eef1f6",
    "surface": "rgba(255,255,255,0.92)",
    "surfaceElevated": "#ffffff",
    "border": "#e5ebf3",
    "borderStrong": "#c7d2e0",
    "text": "#1f2937",
    "textMuted": "#6b7280",
    "textFaint": "#9ca3af",
    "accent": "#3b82f6",
    "accent2": "#6366f1",
    "accent3": "#8b5cf6",
    "success": "#34d399",
    "warning": "#f59e0b",
    "danger": "#f43f5e",
    "glow": "rgba(59, 130, 246, 0.32)"
  },
  "typography": {
    "fontFamily": "\"IBM Plex Sans Arabic\", \"Segoe UI\", Tahoma, sans-serif",
    "monoFamily": "\"JetBrains Mono\", ui-monospace, monospace",
    "scale": {
      "xs": "0.72rem",
      "sm": "0.82rem",
      "md": "0.95rem",
      "lg": "1.15rem",
      "xl": "1.45rem"
    },
    "lineHeight": "1.5",
    "letterSpacing": "0"
  },
  "shape": {
    "radiusSm": "14px",
    "radiusMd": "22px",
    "radiusLg": "28px",
    "borderWidth": "1px",
    "radiusPill": "999px"
  },
  "elevation": {
    "shadowSm": "0 12px 28px rgba(15,23,42,0.07)",
    "shadowMd": "0 18px 48px rgba(15,23,42,0.08)",
    "glowBlur": "16px",
    "shadowLg": "0 28px 64px rgba(15,23,42,0.12)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "slow": "280ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "hoverLift": "translateY(-2px)"
  },
